  "entrypoints": {
    "mcp": {
      "printonator": {
        "type": "stdio",
        "command": "Printonator.Mcp.exe",
        "args": ["--stdio"],
        "env": {
          "PRINTONATOR_REQUIRE_APPROVE": "false",
          "PRINTONATOR_ALLOWED_PRINTERS": "Microsoft Print to PDF"
        }
      }
    }
  },
  "skills": [
    { "name": "printonator-mcp", "path": ".claude/skills/printonator-mcp/SKILL.md" }
  ]
}