{
  "name": "printonator-mcp",
  "version": "0.1.8",
  "description": "Printonator MCP — AI in file giùm (liệt kê máy in, tự chọn máy, in hàng loạt word/excel/ppt, duyệt job, tra cứu mã lỗi). Kèm skill printonator-mcp.",
  "author": "Printonator",
