<Window x:Class="Printonator.UI.PresetManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l10n="clr-namespace:Printonator.UI.Localization"
        Title="{l10n:Loc Preset.ManageTitle}" Height="380" Width="460"
        MinWidth="420" MinHeight="320"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        AutomationProperties.AutomationId="PresetManagerWindow"
        Background="#FFFFFF" FontFamily="Segoe UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <TextBlock Text="{l10n:Loc Preset.ManageTitle}" FontSize="16" FontWeight="SemiBold"
                       Foreground="{StaticResource TextBrush}" Margin="16,14"/>
        </Border>

        <!-- Danh sách preset -->
        <Grid Grid.Row="1" Margin="16,12,16,8">
            <ListBox x:Name="PresetList" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                     Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     SelectionChanged="PresetList_SelectionChanged" AutomationProperties.AutomationId="PresetList">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}" FontSize="13" Foreground="{StaticResource TextBrush}"
                                   Padding="6,8"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="EmptyText" Text="{l10n:Loc Preset.EmptyList}" FontSize="12"
                       Foreground="{StaticResource FaintBrush}" HorizontalAlignment="Center"
                       VerticalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False"/>
        </Grid>

        <!-- Đổi tên + thao tác -->
        <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Background="#FAFAFA">
            <StackPanel Margin="16,10,16,14">
                <TextBlock Text="{l10n:Loc Preset.NewName}" FontSize="11.5" FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}" Margin="0,0,0,4"/>
                <TextBox x:Name="NameBox" Height="28" Padding="8,3" AutomationProperties.AutomationId="PresetNameBox"/>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button x:Name="NoProfileBtn" Content="{l10n:Loc Preset.NoProfileButton}" Style="{StaticResource GhostBtn}"
                            Padding="12,6" AutomationProperties.AutomationId="PresetNoProfileBtn" Click="NoProfile_Click"/>
                    <Button x:Name="RenameBtn" Content="{l10n:Loc Preset.RenameButton}" Style="{StaticResource GhostBtn}"
                            Padding="12,6" Margin="8,0,0,0" AutomationProperties.AutomationId="PresetRenameBtn" Click="Rename_Click"/>
                    <Button x:Name="DeleteBtn" Content="{l10n:Loc Preset.DeleteButton}" Style="{StaticResource GhostBtn}"
                            Padding="12,6" Margin="8,0,0,0" AutomationProperties.AutomationId="PresetDeleteBtn" Click="Delete_Click"/>
                    <Button x:Name="ApplyBtn" Content="{l10n:Loc Preset.ApplyButton}" Style="{StaticResource RoundedBtn}"
                            Padding="14,6" Margin="8,0,0,0" AutomationProperties.AutomationId="PresetApplyBtn" Click="Apply_Click"/>
                    <TextBlock x:Name="StatusText" FontSize="11" Foreground="{StaticResource FaintBrush}"
                               VerticalAlignment="Center" Margin="12,0,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>