<Window x:Class="Printonator.UI.PrintSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l10n="clr-namespace:Printonator.UI.Localization"
        Title="{l10n:Loc Settings.WindowTitle}" Height="680" Width="840"
        MinHeight="600" MinWidth="720"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        AutomationProperties.AutomationId="PrintSettingsWindow"
        Background="#FFFFFF" FontFamily="Segoe UI">
    <Window.Resources>
        <!-- Label cho từng option trong form — đồng nhất margin + kiểu chữ -->
        <Style x:Key="OptionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#1F1F1F"/>
            <Setter Property="Margin" Value="0,10,0,4"/>
        </Style>
        <!-- Chỉ dẫn ngắn dưới mỗi option — giúp user biết option ảnh hưởng gì -->
        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Foreground" Value="#8A8A8A"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
        <!-- Tiêu đề nhóm option trong mỗi cột -->
        <Style x:Key="GroupTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1F1F1F"/>
            <Setter Property="Margin" Value="0,6,0,2"/>
        </Style>

        <!-- ===== TabControl dạng segmented (2 tab: Cơ bản / Nâng cao) — hợp design system ===== -->
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="#F0F0EE" CornerRadius="8" Padding="3"
                                    HorizontalAlignment="Left">
                                <TabPanel IsItemsHost="True" KeyboardNavigation.TabIndex="1" Panel.ZIndex="1"/>
                            </Border>
                            <Border Grid.Row="1" Background="White" BorderBrush="#E5E5E5" BorderThickness="1"
                                    CornerRadius="8" Padding="16" Margin="0,10,0,0">
                                <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#6B6B6B"/>
            <Setter Property="Padding" Value="20,7"/>
            <Setter Property="Margin" Value="0,0,2,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Hover TRƯỚC, Selected SAU: selected luôn thắng hover — tab đang chọn không
                                 đổi màu lúc rê chuột (trước đây hover đè selected gây chớp trắng/xám) -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E7E7E4"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="White"/>
                                <Setter Property="Foreground" Value="#1F1F1F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">

            <!-- ===== Tiêu đề + chỉ dẫn ===== -->
            <TextBlock x:Name="TitleText" FontSize="15" FontWeight="SemiBold" Foreground="#1F1F1F"/>
            <TextBlock Text="{l10n:Loc Settings.Introduction}"
                       FontSize="11" Foreground="#8A8A8A" TextWrapping="Wrap" Margin="0,2,0,0"/>

            <!-- ===== Profile (printer template) — dùng chung cho cả 2 tab ===== -->
            <Border Background="#F6F6F4" BorderBrush="#D4D4D4" BorderThickness="1"
                    CornerRadius="8" Padding="10,8" Margin="0,14,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{l10n:Loc Settings.ProfileTitle}" FontSize="12" FontWeight="SemiBold"
                                   Foreground="#1F1F1F" VerticalAlignment="Center"/>
                        <ComboBox x:Name="ProfileCombo" Width="240" FontSize="12" Margin="10,0,0,0"
                                  VerticalAlignment="Center" SelectionChanged="ProfileCombo_SelectionChanged"
                                  ToolTip="{l10n:Loc Settings.ProfileComboTooltip}"/>
                        <Button x:Name="SaveProfileBtn" Content="{l10n:Loc Settings.SaveProfileBtn}" Style="{StaticResource GhostBtn}"
                                Padding="10,5" Margin="8,0,0,0" Click="SaveProfile_Click"/>
                        <Button x:Name="DeleteProfileBtn" Content="{l10n:Loc Settings.DeleteProfileBtn}" Style="{StaticResource GhostBtn}"
                                Padding="10,5" Margin="8,0,0,0" Click="DeleteProfile_Click"/>
                        <Button x:Name="ExportPresetBtn" Content="{l10n:Loc Preset.ExportButton}" Style="{StaticResource GhostBtn}"
                                Padding="10,5" Margin="8,0,0,0" Click="ExportPreset_Click"
                                AutomationProperties.AutomationId="ExportPresetBtn"/>
                        <Button x:Name="ImportPresetBtn" Content="{l10n:Loc Preset.ImportButton}" Style="{StaticResource GhostBtn}"
                                Padding="10,5" Margin="8,0,0,0" Click="ImportPreset_Click"
                                AutomationProperties.AutomationId="ImportPresetBtn"/>
                    </StackPanel>
                    <!-- Panel nhập tên profile khi bấm Lưu -->
                    <StackPanel x:Name="SavePanel" Orientation="Horizontal" Visibility="Collapsed" Margin="0,8,0,0">
                        <TextBox x:Name="ProfileNameBox" Width="220" FontSize="12" Padding="4,3"
                                 ToolTip="{l10n:Loc Settings.ProfileNameTooltip}" VerticalContentAlignment="Center"/>
                        <Button Content="{l10n:Loc Settings.SaveProfileConfirmBtn}" Style="{StaticResource RoundedBtn}" Padding="12,4"
                                Margin="8,0,0,0" Click="ConfirmSaveProfile_Click"/>
                        <Button Content="{l10n:Loc Common.CancelButton}" Style="{StaticResource GhostBtn}" Padding="12,4"
                                Margin="8,0,0,0" Click="CancelSaveProfile_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ===== 2 tab: Cơ bản (người dùng phổ thông) / Nâng cao ===== -->
            <TabControl Margin="0,12,0,0">

                <!-- ================= TAB CƠ BẢN ================= -->
                <TabItem Header="{l10n:Loc Settings.TabBasic}">
                    <StackPanel>
                        <!-- 2 cột tận dụng chiều rộng cửa sổ: trái = trang & bản, phải = giấy & màu -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Cột trái: Trang & bản in -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{l10n:Loc Settings.GroupPagesCopies}" Style="{StaticResource GroupTitle}"/>

                                <TextBlock Text="{l10n:Loc Settings.OptionCopies}" Style="{StaticResource OptionLabel}"/>
                                <TextBox x:Name="CopiesBox" Width="70" FontSize="13" Padding="4,3" HorizontalAlignment="Left"
                                         MaxLength="3" VerticalContentAlignment="Center" TextChanged="Copies_TextChanged"/>
                                <TextBlock Text="{l10n:Loc Settings.HintCopies}" Style="{StaticResource HintText}"/>
                                <TextBlock x:Name="CopiesError" Text="{l10n:Loc Settings.ErrorCopiesRange}" FontSize="10.5"
                                           Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap"
                                           Margin="0,2,0,0" Visibility="Collapsed"/>

                                <TextBlock Text="{l10n:Loc Settings.OptionPageRange}" Style="{StaticResource OptionLabel}"/>
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="RangeAll" Content="{l10n:Loc Settings.RangeAllRadio}" GroupName="Range" FontSize="12"
                                                 VerticalAlignment="Center" Checked="Range_Changed"/>
                                    <RadioButton x:Name="RangeCustom" Content="{l10n:Loc Settings.RangeCustomRadio}" GroupName="Range" FontSize="12"
                                                 Margin="14,0,0,0" VerticalAlignment="Center" Checked="Range_Changed"/>
                                    <TextBox x:Name="RangeBox" Width="130" FontSize="12" Padding="3,2" Margin="6,0,0,0"
                                             IsEnabled="False" VerticalContentAlignment="Center" TextChanged="Range_Changed"
                                             ToolTip="{l10n:Loc Settings.RangeBoxTooltip}"/>
                                </StackPanel>
                                <TextBlock x:Name="RangePreview" FontSize="11" Foreground="#16A34A" TextWrapping="Wrap"
                                           Margin="0,4,0,0"/>
                                <TextBlock x:Name="SectionInfo" FontSize="11" Foreground="#C2410C" TextWrapping="Wrap"
                                           Margin="0,2,0,0" Visibility="Collapsed"/>
                                <TextBlock x:Name="RangeErrText" Text="{l10n:Loc Settings.ErrorRangeSyntax}"
                                           FontSize="10.5" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap"
                                           Margin="0,2,0,0" Visibility="Collapsed"/>
                                <TextBlock Text="{l10n:Loc Settings.HintRangeSyntax}"
                                           Style="{StaticResource HintText}"/>
                            </StackPanel>

                            <!-- Cột phải: Giấy & màu -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{l10n:Loc Settings.GroupPaperColor}" Style="{StaticResource GroupTitle}"/>

                                <TextBlock x:Name="SheetLabel" Text="{l10n:Loc Settings.SheetOption}" Style="{StaticResource OptionLabel}" Visibility="Collapsed"/>
                                <ComboBox x:Name="SheetCombo" Width="330" FontSize="12" HorizontalAlignment="Left" Visibility="Collapsed"/>
                                <TextBlock x:Name="SheetHint" Text="{l10n:Loc Settings.SheetHint}" Style="{StaticResource HintText}" Visibility="Collapsed"/>

                                <TextBlock Text="{l10n:Loc Settings.OptionPaper}" Style="{StaticResource OptionLabel}"/>
                                <ComboBox x:Name="PaperCombo" Width="330" FontSize="12" HorizontalAlignment="Left"/>
                                <TextBlock Text="{l10n:Loc Settings.HintPaper}" Style="{StaticResource HintText}"/>

                                <TextBlock Text="{l10n:Loc Settings.OptionDuplex}" Style="{StaticResource OptionLabel}"/>
                                <ComboBox x:Name="DuplexCombo" Width="330" FontSize="12" HorizontalAlignment="Left">
                                    <ComboBoxItem Content="{l10n:Loc Option.AsPrinter}" Tag="AsPrinter"/>
                                    <ComboBoxItem Content="{l10n:Loc Option.Simplex}" Tag="Simplex"/>
                                    <ComboBoxItem Content="{l10n:Loc Option.LongEdge}" Tag="LongEdge"/>
                                    <ComboBoxItem Content="{l10n:Loc Option.ShortEdge}" Tag="ShortEdge"/>
                                </ComboBox>
                                <TextBlock Text="{l10n:Loc Settings.HintDuplex}" Style="{StaticResource HintText}"/>

                                <TextBlock Text="{l10n:Loc Settings.OptionColor}" Style="{StaticResource OptionLabel}"/>
                                <ComboBox x:Name="ColorModeCombo" Width="330" FontSize="12" HorizontalAlignment="Left">
                                    <ComboBoxItem Content="{l10n:Loc Option.AsPrinter}" Tag="AsPrinter"/>
                                    <ComboBoxItem Content="{l10n:Loc Option.AsDocument}" Tag="AsDocument"/>
                                    <ComboBoxItem Content="{l10n:Loc Option.Color}" Tag="Color"/>
                                    <ComboBoxItem Content="{l10n:Loc Option.Grayscale}" Tag="Grayscale"/>
                                </ComboBox>
                                <TextBlock Text="{l10n:Loc Settings.HintColor}" Style="{StaticResource HintText}"/>

                                <CheckBox x:Name="FitToPageWideCheck" Content="{l10n:Loc Settings.FitToPageWideCheck}" FontSize="12" Margin="0,10,0,0"/>
                                <TextBlock Text="{l10n:Loc Settings.HintFitToPageWide}" Style="{StaticResource HintText}"/>

                                <CheckBox x:Name="AutoOrientationCheck" Content="{l10n:Loc Settings.AutoOrientationCheck}" FontSize="12" Margin="0,10,0,0"/>
                                <TextBlock Text="{l10n:Loc Settings.HintAutoOrientation}" Style="{StaticResource HintText}"/>

                                <!-- ===== Phase 2 (Lite): Cài đặt lô — Cover page + Merge, ẩn cả khối ở chế độ Lite ===== -->
                                <StackPanel x:Name="AdvancedBatchPanel">
                                    <CheckBox x:Name="CoverPageCheck" Content="{l10n:Loc Settings.CoverPage}" FontSize="12" Margin="0,10,0,0"/>
                                    <TextBlock Text="{l10n:Loc Settings.CoverPageHint}" Style="{StaticResource HintText}"/>

                                    <CheckBox x:Name="MergeCheck" Content="{l10n:Loc Settings.MergeIntoOne}" FontSize="12" Margin="0,10,0,0"/>
                                    <TextBlock Text="{l10n:Loc Settings.MergeHint}" Style="{StaticResource HintText}"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <!-- Cài đặt máy in (driver) — khối full-width cuối tab, cùng kiểu khối Profile ở trên -->
                        <Border Background="#F6F6F4" BorderBrush="#D4D4D4" BorderThickness="1"
                                CornerRadius="8" Padding="10,8" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="{l10n:Loc Settings.DriverTitle}" FontSize="12" FontWeight="SemiBold" Foreground="#1F1F1F"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBlock x:Name="PrinterNameText" Text="{l10n:Loc Settings.NoPrinterSelected}"
                                               FontSize="12" Foreground="#6B6B6B" VerticalAlignment="Center"/>
                                    <Button x:Name="PrefsBtn" Content="{l10n:Loc Settings.PrefsButton}" Style="{StaticResource GhostBtn}"
                                            Padding="12,6" Margin="12,0,0,0" Click="Prefs_Click"/>
                                    <Button x:Name="PropsBtn" Content="{l10n:Loc Settings.PropsButton}" Style="{StaticResource GhostBtn}"
                                            Padding="12,6" Margin="8,0,0,0" Click="Props_Click"/>
                                </StackPanel>
                                <TextBlock Text="{l10n:Loc Settings.HintDriver}"
                                           FontSize="10.5" Foreground="#8A8A8A" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                <TextBlock x:Name="NativeErrText" FontSize="11" Foreground="#DC2626" TextWrapping="Wrap"
                                           Margin="0,4,0,0" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </TabItem>

                <!-- ================= TAB NÂNG CAO ================= -->
                <TabItem Header="{l10n:Loc Settings.TabAdvanced}">
                    <StackPanel>
                        <TextBlock Text="{l10n:Loc Settings.AdvancedIntro}" FontSize="11"
                                   Foreground="#8A8A8A" TextWrapping="Wrap" Margin="0,0,0,4"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Cột A -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{l10n:Loc Settings.GroupPagesCopiesAdvanced}" Style="{StaticResource GroupTitle}"/>

                                <TextBlock Text="{l10n:Loc Settings.OptionParity}" Style="{StaticResource OptionLabel}"/>
                                <ComboBox x:Name="ParityCombo" Width="280" FontSize="12" HorizontalAlignment="Left">
                                    <ComboBoxItem Content="{l10n:Loc Option.AllPages}" Tag="All"/>
                                    <ComboBoxItem Content="{l10n:Loc Option.OddPages}" Tag="Odd"/>
                                    <ComboBoxItem Content="{l10n:Loc Option.EvenPages}" Tag="Even"/>
                                </ComboBox>
                                <TextBlock Text="{l10n:Loc Settings.HintParity}" Style="{StaticResource HintText}"/>

                                <TextBlock Text="{l10n:Loc Settings.OptionCollation}" Style="{StaticResource OptionLabel}"/>
                                <ComboBox x:Name="CollationCombo" Width="280" FontSize="12" HorizontalAlignment="Left">
                                    <ComboBoxItem Content="{l10n:Loc Option.AsPrinter}" Tag="AsPrinter"/>
                                    <ComboBoxItem Content="{l10n:Loc Option.ByDocuments}" Tag="ByDocuments"/>
                                    <ComboBoxItem Content="{l10n:Loc Option.ByPages}" Tag="ByPages"/>
                                </ComboBox>
                                <TextBlock Text="{l10n:Loc Settings.HintCollation}" Style="{StaticResource HintText}"/>
                            </StackPanel>

                            <!-- Cột B -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{l10n:Loc Settings.GroupPaperLayout}" Style="{StaticResource GroupTitle}"/>

                                <TextBlock Text="{l10n:Loc Settings.OptionPaperSource}" Style="{StaticResource OptionLabel}"/>
                                <ComboBox x:Name="PaperSourceCombo" Width="300" FontSize="12" HorizontalAlignment="Left"/>
                                <TextBlock Text="{l10n:Loc Settings.HintPaperSource}" Style="{StaticResource HintText}"/>

                                <TextBlock Text="{l10n:Loc Settings.OptionOrientation}" Style="{StaticResource OptionLabel}"/>
                                <ComboBox x:Name="OrientationCombo" Width="300" FontSize="12" HorizontalAlignment="Left">
                                    <ComboBoxItem Content="{l10n:Loc Option.AsDocument}" Tag="AsDocument"/>
                                    <ComboBoxItem Content="{l10n:Loc Option.AsPrinter}" Tag="AsPrinter"/>
                                    <ComboBoxItem Content="{l10n:Loc Option.Portrait}" Tag="Portrait"/>
                                    <ComboBoxItem Content="{l10n:Loc Option.Landscape}" Tag="Landscape"/>
                                </ComboBox>
                                <TextBlock Text="{l10n:Loc Settings.HintOrientation}" Style="{StaticResource HintText}"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="{l10n:Loc Settings.OptionScale}" Style="{StaticResource OptionLabel}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0" x:Name="ScaleModeCombo" Width="205" FontSize="12"
                                      HorizontalAlignment="Left" SelectionChanged="ScaleMode_Changed">
                                <ComboBoxItem Content="{l10n:Loc Option.AsDocument}" Tag="AsDocument"/>
                                <ComboBoxItem Content="{l10n:Loc Option.Shrink}" Tag="ShrinkToPrintable"/>
                                <ComboBoxItem Content="{l10n:Loc Option.Fit}" Tag="FitToPrintable"/>
                                <ComboBoxItem Content="{l10n:Loc Option.Original}" Tag="Original"/>
                                <ComboBoxItem Content="{l10n:Loc Option.Fill}" Tag="Fill"/>
                                <ComboBoxItem Content="{l10n:Loc Option.Zoom}" Tag="Zoom"/>
                            </ComboBox>
                            <TextBox Grid.Column="1" x:Name="ZoomBox" Width="56" FontSize="12" Padding="3,2"
                                     Margin="8,0,0,0" IsEnabled="False" Text="100" TextAlignment="Right"
                                     VerticalContentAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="%" FontSize="12" Foreground="#6B6B6B"
                                       VerticalAlignment="Center" Margin="4,0,0,0"/>
                        </Grid>
                        <TextBlock Text="{l10n:Loc Settings.HintScale}" Style="{StaticResource HintText}"/>

                        <TextBlock Text="{l10n:Loc Settings.OptionPerSheet}" Style="{StaticResource OptionLabel}"/>
                        <ComboBox x:Name="PerSheetCombo" Width="340" FontSize="12" HorizontalAlignment="Left">
                            <ComboBoxItem Content="{l10n:Loc Option.PerSheet1}" Tag="1"/>
                            <ComboBoxItem Content="{l10n:Loc Option.PerSheet2}" Tag="2"/>
                            <ComboBoxItem Content="{l10n:Loc Option.PerSheet4}" Tag="4"/>
                            <ComboBoxItem Content="{l10n:Loc Option.PerSheet6}" Tag="6"/>
                            <ComboBoxItem Content="{l10n:Loc Option.PerSheet9}" Tag="9"/>
                            <ComboBoxItem Content="{l10n:Loc Option.PerSheet16}" Tag="16"/>
                            <ComboBoxItem Content="{l10n:Loc Option.Booklet}" Tag="booklet"/>
                        </ComboBox>
                        <TextBlock Text="{l10n:Loc Settings.HintPerSheet}" Style="{StaticResource HintText}"/>

                        <TextBlock Text="{l10n:Loc Settings.OptionQuality}" Style="{StaticResource OptionLabel}"/>
                        <ComboBox x:Name="QualityCombo" Width="340" FontSize="12" HorizontalAlignment="Left">
                            <ComboBoxItem Content="{l10n:Loc Option.AsPrinter}" Tag="AsPrinter"/>
                            <ComboBoxItem Content="{l10n:Loc Option.QualityHigh}" Tag="High"/>
                            <ComboBoxItem Content="{l10n:Loc Option.QualityMedium}" Tag="Medium"/>
                            <ComboBoxItem Content="{l10n:Loc Option.QualityLow}" Tag="Low"/>
                            <ComboBoxItem Content="{l10n:Loc Option.QualityDraft}" Tag="Draft"/>
                        </ComboBox>
                        <TextBlock Text="{l10n:Loc Settings.HintQuality}" Style="{StaticResource HintText}"/>

                        <!-- ===== Phase 2 (Lite): Watermark, ẩn cả khối ở chế độ Lite ===== -->
                        <StackPanel x:Name="WatermarkPanel">
                            <TextBlock Text="{l10n:Loc Settings.WatermarkText}" Style="{StaticResource OptionLabel}"/>
                            <TextBox x:Name="WatermarkText" Width="200" FontSize="12" Padding="4,3"
                                     HorizontalAlignment="Left" VerticalContentAlignment="Center"/>
                            <TextBlock Text="{l10n:Loc Settings.WatermarkTextHint}" Style="{StaticResource HintText}"/>

                            <TextBlock Text="{l10n:Loc Settings.WatermarkOpacity}" Style="{StaticResource OptionLabel}"/>
                            <StackPanel Orientation="Horizontal">
                                <Slider x:Name="WatermarkOpacitySlider" Width="220" Minimum="0.1" Maximum="1.0"
                                        SmallChange="0.05" LargeChange="0.1" TickFrequency="0.05" IsSnapToTickEnabled="True"
                                        ValueChanged="WatermarkOpacity_Changed" VerticalAlignment="Center"/>
                                <TextBlock x:Name="WatermarkOpacityValue" Text="30%" FontSize="12" Foreground="#6B6B6B"
                                           VerticalAlignment="Center" Margin="10,0,0,0"/>
                            </StackPanel>
                            <TextBlock Text="{l10n:Loc Settings.WatermarkOpacityHint}" Style="{StaticResource HintText}"/>
                        </StackPanel>
                    </StackPanel>
                </TabItem>
            </TabControl>

            <!-- ===== Footer ===== -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button x:Name="ApplyBtn" Content="{l10n:Loc Settings.ApplyButton}" Style="{StaticResource RoundedBtn}"
                        Padding="18,8" Click="Apply_Click"/>
                <Button Content="{l10n:Loc Common.CancelButton}" Style="{StaticResource GhostBtn}" Padding="18,8" Margin="10,0,0,0"
                        Click="Cancel_Click"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>