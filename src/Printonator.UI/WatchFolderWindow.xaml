<Window x:Class="Printonator.UI.WatchFolderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l10n="clr-namespace:Printonator.UI.Localization"
        Title="{l10n:Loc Watch.WindowTitle}" Height="320" Width="460"
        MinWidth="420" MinHeight="280"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        AutomationProperties.AutomationId="WatchFolderWindow"
        Background="#FFFFFF" FontFamily="Segoe UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <TextBlock Text="{l10n:Loc Watch.WindowTitle}" FontSize="16" FontWeight="SemiBold"
                       Foreground="{StaticResource TextBrush}" Margin="16,14"/>
        </Border>

        <!-- Nội dung: trạng thái watch hiện tại -->
        <StackPanel Grid.Row="1" Margin="16,12,16,8" VerticalAlignment="Top">
            <TextBlock x:Name="CurrentFolderText" Text="{l10n:Loc Watch.NoFolder}" FontSize="13"
                       Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis"
                       ToolTip="{l10n:Loc Watch.NoFolder}" Margin="0,0,0,4"
                       AutomationProperties.AutomationId="WatchCurrentFolderText"/>
            <TextBlock x:Name="StatusText" Text="{l10n:Loc Watch.StatusInactive}" FontSize="12"
                       Foreground="#DC2626" Margin="0,0,0,12"
                       AutomationProperties.AutomationId="WatchStatusText"/>
            <TextBlock Text="{l10n:Loc Watch.InfoNote}" FontSize="11"
                       Foreground="{StaticResource FaintBrush}" TextWrapping="Wrap"
                       AutomationProperties.AutomationId="WatchInfoNote"/>
        </StackPanel>

        <!-- Footer: Select folder / Stop watching / Close -->
        <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Background="#FAFAFA">
            <StackPanel Margin="16,10,16,14" Orientation="Horizontal">
                <Button x:Name="SelectFolderBtn" Content="{l10n:Loc Watch.SelectFolder}"
                        Style="{StaticResource RoundedBtn}" Padding="14,6"
                        AutomationProperties.AutomationId="WatchSelectFolderBtn"
                        Click="SelectFolder_Click"/>
                <Button x:Name="StopWatchBtn" Content="{l10n:Loc Watch.StopWatching}"
                        Style="{StaticResource GhostBtn}" Padding="12,6" Margin="8,0,0,0"
                        AutomationProperties.AutomationId="WatchStopBtn"
                        IsEnabled="False" Click="StopWatch_Click"/>
                <Button x:Name="CloseBtn" Content="{l10n:Loc About.CloseButton}"
                        Style="{StaticResource GhostBtn}" Padding="14,6" Margin="8,0,0,0"
                        AutomationProperties.AutomationId="WatchCloseBtn"
                        HorizontalAlignment="Right" Click="Close_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>