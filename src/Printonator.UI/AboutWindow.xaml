<Window x:Class="Printonator.UI.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l10n="clr-namespace:Printonator.UI.Localization"
        Title="{l10n:Loc About.WindowTitle}"
        Width="520" MinWidth="520" SizeToContent="Height" MaxHeight="620"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="#FFFFFF" FontFamily="Segoe UI">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24,20,24,20">
        <TextBlock Text="Printonator" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
        <TextBlock x:Name="VersionText" Text="{l10n:Loc About.VersionText}" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"/>

        <TextBlock Text="{l10n:Loc About.ChangeLogTitle}" FontSize="14" FontWeight="SemiBold"
                   Foreground="{StaticResource TextBrush}" Margin="0,18,0,6"/>
        <Border Background="{StaticResource HeaderBgBrush}" CornerRadius="8" Padding="12,10">
            <TextBlock x:Name="ChangeLogText" FontSize="11.5" Foreground="{StaticResource TextBrush}"
                       TextWrapping="Wrap" Text="{l10n:Loc About.ChangeLogLoading}"/>
        </Border>

        <TextBlock Text="{l10n:Loc About.LicenseTitle}" FontSize="14" FontWeight="SemiBold"
                   Foreground="{StaticResource TextBrush}" Margin="0,18,0,6"/>
        <TextBlock Text="{l10n:Loc About.LicenseText}" FontSize="11.5"
                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>

        <TextBlock Text="{l10n:Loc About.AuthorTitle}" FontSize="14" FontWeight="SemiBold"
                   Foreground="{StaticResource TextBrush}" Margin="0,18,0,6"/>
        <TextBlock TextWrapping="Wrap" FontSize="11.5" Foreground="{StaticResource TextBrush}">
            <Run Text="{l10n:Loc About.AuthorText}"/><Hyperlink NavigateUri="https://labm.io.vn" RequestNavigate="Hyperlink_Navigate"><Run Text="{l10n:Loc About.AuthorLink}"/></Hyperlink><Run Text="{l10n:Loc About.AuthorLinkSuffix}"/>
        </TextBlock>

        <TextBlock Text="{l10n:Loc About.ContactTitle}" FontSize="14" FontWeight="SemiBold"
                   Foreground="{StaticResource TextBrush}" Margin="0,18,0,6"/>
        <StackPanel>
            <TextBlock TextWrapping="Wrap" FontSize="11.5" Foreground="{StaticResource TextBrush}">
                <Run Text="{l10n:Loc About.GitHubLabel}"/>
                <Hyperlink NavigateUri="https://github.com/nanowind/Printonator" RequestNavigate="Hyperlink_Navigate">
                    github.com/nanowind/Printonator
                </Hyperlink>
                <Run Text="{l10n:Loc About.GitHubSuffix}"/>
            </TextBlock>
            <TextBlock TextWrapping="Wrap" FontSize="11.5" Margin="0,6,0,0">
                <Run Text="{l10n:Loc About.EmailText}"/>
            </TextBlock>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button Content="{l10n:Loc About.CloseButton}" Style="{StaticResource RoundedBtn}" Padding="24,7" IsDefault="True" Click="Close_Click"/>
        </StackPanel>

        <Separator Margin="0,10,0,6" Background="#EDEDED"/>
        <StackPanel Orientation="Horizontal" Margin="0,4,0,0" VerticalAlignment="Center">
            <TextBlock Text="{l10n:Loc About.LanguageLabel}" FontSize="11.5" Foreground="{StaticResource MutedBrush}"
                       VerticalAlignment="Center" Margin="0,0,10,0"/>
            <ComboBox x:Name="LanguageCombo" Width="220" FontSize="12" VerticalAlignment="Center"
                      SelectionChanged="LanguageCombo_SelectionChanged"
                      ToolTip="{l10n:Loc About.LanguageTooltip}"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,8,0,0" VerticalAlignment="Center">
            <TextBlock Text="{l10n:Loc Mode.ModeLabel}" FontSize="11.5" Foreground="{StaticResource MutedBrush}"
                       VerticalAlignment="Center" Margin="0,0,10,0"/>
            <ComboBox x:Name="ModeCombo" Width="220" FontSize="12" VerticalAlignment="Center"
                      SelectionChanged="ModeCombo_SelectionChanged"/>
        </StackPanel>
    </StackPanel>
    </ScrollViewer>
</Window>