<Window x:Class="Printonator.UI.PrintDoneWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l10n="clr-namespace:Printonator.UI.Localization"
        Title="{l10n:Loc Done.WindowTitle}"
        Width="460" Height="Auto" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#FFFFFF" FontFamily="Segoe UI"
        ShowInTaskbar="False">
    <StackPanel Margin="24,20,24,16">
        <TextBlock Text="{l10n:Loc Done.Title}" FontSize="17" FontWeight="SemiBold"
                   Foreground="{StaticResource ReadyBrush}"/>
        <TextBlock x:Name="DoneText" FontSize="12.5" Foreground="{StaticResource TextBrush}"
                   TextWrapping="Wrap" Margin="0,10,0,0"/>
        <TextBlock x:Name="SideNote" FontSize="11.5" Foreground="{StaticResource WarnBrush}"
                   TextWrapping="Wrap" Margin="0,6,0,0" Visibility="Collapsed"/>

        <!-- Opt-in: xóa file đã in khỏi hàng đợi -->
        <CheckBox x:Name="RemoveDoneChk" Content="{l10n:Loc Done.RemoveCheck}"
                  FontSize="12" Foreground="{StaticResource TextBrush}" Margin="0,14,0,0"
                  IsChecked="True" Cursor="Hand"/>

        <Separator Margin="0,16,0,0"/>

        <!-- About / license / contact (luôn hiển thị để người dùng biết) -->
        <TextBlock Text="Printonator" FontSize="13" FontWeight="SemiBold"
                   Foreground="{StaticResource TextBrush}" Margin="0,10,0,0"/>
        <TextBlock x:Name="VersionText" Text="{l10n:Loc Done.VersionText}" FontSize="11"
                   Foreground="{StaticResource FaintBrush}" Margin="0,2,0,0"/>
        <TextBlock Text="{l10n:Loc Done.LicenseText}"
                   FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
        <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0">
            <Hyperlink NavigateUri="https://github.com/nanowind/Printonator" RequestNavigate="Hyperlink_Navigate">
                github.com/nanowind/Printonator
            </Hyperlink>
            <LineBreak/>
            <Run Text="{l10n:Loc Done.RateRequest}"/>
        </TextBlock>
        <TextBlock Text="{l10n:Loc Done.ContactText}"
                   FontSize="11" Foreground="{StaticResource FaintBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
        <Button Content="{l10n:Loc Common.CheckUpdateButton}" Style="{StaticResource GhostBtn}" Padding="12,5"
                Margin="0,12,0,0" HorizontalAlignment="Left" Click="CheckUpdate_Click"/>
        <TextBlock x:Name="UpdateStatusText" FontSize="11" Foreground="{StaticResource MutedBrush}"
                   TextWrapping="Wrap" Margin="0,6,0,0"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="{l10n:Loc Common.OkButton}" Style="{StaticResource RoundedBtn}" Padding="24,7"
                    IsDefault="True" Click="Ok_Click"/>
        </StackPanel>
    </StackPanel>
</Window>