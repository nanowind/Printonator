<Window x:Class="Printonator.UI.PageRangeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chọn trang" Height="Auto" Width="460"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#FFFFFF" FontFamily="Segoe UI">
    <Window.Resources>
        <!-- Styles/Toàn app: Buttons trong App.Resources -->
    </Window.Resources>
    <StackPanel Margin="24">
        <TextBlock x:Name="FileNameText" FontSize="15" FontWeight="SemiBold" Foreground="#1F1F1F" Margin="0,0,0,6"/>
        <TextBlock Text="Nhập trang cần in:" FontSize="12" Foreground="#6B6B6B" Margin="0,0,0,4"/>

        <TextBox x:Name="PageRangeBox" Text="All" FontSize="13" Padding="8,6" Margin="0,0,0,4"
                 BorderBrush="#D4D4D4" BorderThickness="1" VerticalContentAlignment="Center"
                 TextChanged="PageRangeBox_TextChanged"/>

        <TextBlock Text="Định dạng: All · 2,5 · 3-4 · 1-2,7 · S2:1-3 (section 2, trang 1-3)"
                   FontSize="11" Foreground="#8A8A8A" Margin="0,0,0,4"/>

        <TextBlock x:Name="PreviewText" FontSize="11" Foreground="#16A34A" Margin="0,0,0,4"
                   TextWrapping="Wrap" Visibility="Collapsed"/>

        <TextBlock x:Name="SectionInfo" FontSize="11" Foreground="#C2410C" Margin="0,0,0,4" Visibility="Collapsed"
                   TextWrapping="Wrap"/>

        <TextBlock x:Name="ErrorText" FontSize="11" Foreground="#DC2626" Margin="0,0,0,4" Visibility="Collapsed"
                   TextWrapping="Wrap"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Hủy" Width="90" Padding="0,6" Margin="0,0,10,0" Click="Cancel_Click"
                    Style="{StaticResource GhostBtn}"/>
            <Button Content="OK" Width="90" Padding="0,6" Click="Ok_Click"
                    Style="{StaticResource RoundedBtn}"/>
        </StackPanel>
    </StackPanel>
</Window>