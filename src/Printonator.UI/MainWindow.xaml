<Window x:Class="Printonator.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Printonator.UI"
        xmlns:models="clr-namespace:Printonator.Core.Models;assembly=Printonator.Core"
        xmlns:l10n="clr-namespace:Printonator.UI.Localization"
        Title="Printonator" Height="860" Width="1320"
        WindowStartupLocation="CenterScreen" Icon="app.ico"
        Background="#FFFFFF"
        FontFamily="Segoe UI">
    <Window.TaskbarItemInfo>
        <TaskbarItemInfo x:Name="TaskbarInfo"/>
    </Window.TaskbarItemInfo>
    <Window.Resources>
        <!-- Converters dùng riêng MainWindow (palette + RoundedBtn/GhostBtn đã chuyển lên App.Resources) -->
        <ui:FolderLeafConverter x:Key="FolderLeaf"/>
                                     <!-- ===== Context menu: popup bo góc + đổ bóng, item icon + hover tròn, xóa màu đỏ ===== -->
                                    <Style TargetType="ContextMenu">
                                        <Setter Property="Background" Value="White"/>
                                        <Setter Property="BorderBrush" Value="#EAEAEA"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Setter Property="FontFamily" Value="Segoe UI"/>
                                        <Setter Property="FontSize" Value="12.5"/>
                                        <Setter Property="Foreground" Value="#1F1F1F"/>
                                        <Setter Property="Padding" Value="5"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ContextMenu">
                                                    <Border Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            CornerRadius="10" Padding="{TemplateBinding Padding}">
                                                        <Border.Effect>
                                                            <DropShadowEffect BlurRadius="20" ShadowDepth="3" Direction="270" Opacity="0.16" Color="#000000"/>
                                                        </Border.Effect>
                                                        <ItemsPresenter/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                    <Style TargetType="MenuItem">
                                        <Setter Property="Padding" Value="10,7"/>
                                        <Setter Property="Foreground" Value="#1F1F1F"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="MenuItem">
                                                    <Border x:Name="Bg" Background="Transparent" CornerRadius="6"
                                                            Padding="{TemplateBinding Padding}" Margin="1,1">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="22"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <!-- icon (glyph MDL2 truyền qua Tag) -->
                                                            <TextBlock Grid.Column="0" Text="{TemplateBinding Tag}"
                                                                       FontFamily="Segoe MDL2 Assets" FontSize="13"
                                                                       Foreground="{TemplateBinding Foreground}"
                                                                       Opacity="0.75" VerticalAlignment="Center"/>
                                                            <ContentPresenter Grid.Column="1" ContentSource="Header"
                                                                              VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsHighlighted" Value="True">
                                                            <Setter TargetName="Bg" Property="Background" Value="#F3F3F3"/>
                                                        </Trigger>
                                                        <Trigger Property="IsEnabled" Value="False">
                                                            <Setter Property="Opacity" Value="0.45"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                    <!-- Mục nguy hiểm (Xóa) — chữ + icon đỏ -->
                                    <Style x:Key="DangerMenuItem" TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                        <Setter Property="Foreground" Value="#DC2626"/>
                                    </Style>
                                    <Style TargetType="Separator">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Separator">
                                                    <Border Background="#EDEDED" Height="1" Margin="8,5"/>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                        </Window.Resources>

    <Grid Background="{StaticResource BgBrush}"
          AllowDrop="True" DragEnter="Root_DragEnter" DragOver="Root_DragOver"
          DragLeave="Root_DragLeave" Drop="Root_Drop">
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="52"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="44"/>
        </Grid.RowDefinitions>

        <!-- ===== Header ===== -->
        <Border Grid.Row="0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <DockPanel>
                <!-- Logo: black square + P -->
                <Border Width="26" Height="26" Background="{StaticResource AccentBrush}" CornerRadius="7"
                        Margin="16,0,10,0" VerticalAlignment="Center">
                    <TextBlock Text="P" Foreground="White" FontWeight="Bold" FontSize="14"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="Printonator" FontSize="16" FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                <!-- Search (Penpot gap: icon ⌕) -->
                <Border Background="#F5F5F5" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        CornerRadius="6" Height="28" Margin="20,0,0,0" Padding="8,0" VerticalAlignment="Center">
                    <Grid>
                        <TextBlock Text="⌕" FontSize="13" Foreground="{StaticResource FaintBrush}"
                                   VerticalAlignment="Center" HorizontalAlignment="Left"/>
                        <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0" FontSize="12"
                                 Padding="16,0,0,0" Width="190" VerticalContentAlignment="Center"
                                 ToolTip="{l10n:Loc Main.SearchTooltip}" TextChanged="SearchBox_TextChanged"
                                 AllowDrop="False"/>
                    </Grid>
                </Border>
                <!-- Bell + badge — góc trên phải -->
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right"
                                                            VerticalAlignment="Center" Margin="0,0,16,0">
                                                    <Border Width="30" Height="30" CornerRadius="6" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Background="White">
                                                                            <ToggleButton x:Name="BellToggle" Background="Transparent" BorderThickness="0"
                                                                                          Cursor="Hand" Checked="BellToggle_Changed" Unchecked="BellToggle_Changed">
                                                                                <Grid>
                                                                                    <TextBlock Text="🔔" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
<Border x:Name="BellBadgeBorder" Background="{StaticResource ErrorBrush}" CornerRadius="6" Width="14" Height="14"
                                                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-5,-5,0" Visibility="Collapsed">
                                                        <TextBlock x:Name="BellBadge" Text="0" Foreground="White" FontSize="8" FontWeight="Bold"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                                                </Grid>
                                                                            </ToggleButton>
                                                                        </Border>
                                    <!-- Notification popover (giống Penpot) — danh sách thông báo thật -->
                                    <Popup x:Name="NotifPopup" PlacementTarget="{Binding ElementName=BellToggle}" Placement="Bottom"
                                           StaysOpen="False" AllowsTransparency="True" IsOpen="{Binding IsChecked, ElementName=BellToggle}">
                                        <Border Background="White" BorderBrush="#E5E5E5" BorderThickness="1" CornerRadius="10"
                                                Width="380" Padding="0,0,0,4" Margin="0,6,0,0">
                                            <StackPanel>
                                                <DockPanel Margin="16,12,14,8">
                                                    <TextBlock Text="{l10n:Loc Main.NotifTitle}" FontSize="14" FontWeight="SemiBold" Foreground="#1F1F1F" VerticalAlignment="Center"/>
                                                    <!-- Nút kiểm tra bản mới — kiểu link nhỏ gọn, không đè chữ "Thông báo" -->
                                                    <Button DockPanel.Dock="Right" Content="{l10n:Loc Main.NotifCheckUpdate}"
                                                            Background="Transparent" BorderThickness="0" Foreground="{StaticResource MutedBrush}"
                                                            FontSize="11" Padding="6,3" Cursor="Hand" Click="BellCheckUpdate_Click"
                                                            ToolTip="{l10n:Loc Main.NotifCheckUpdateTooltip}"
                                                            HorizontalAlignment="Right"/>
                                                </DockPanel>
                                                <!-- Danh sách thông báo (thay thế card đơn cũ) — dùng DataTrigger theo Kind để chọn màu, không cần converter -->
                                                <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto">
                                                <ItemsControl ItemsSource="{Binding Notifications}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Button BorderThickness="0"
                                                                    HorizontalContentAlignment="Stretch" Click="NotifItem_Click"
                                                                    ToolTip="{Binding Detail}" Tag="{Binding Id}">
                                                                <Button.Style>
                                                                    <Style TargetType="Button">
                                                                        <Setter Property="Background" Value="Transparent"/>
                                                                        <Setter Property="Template">
                                                                            <Setter.Value>
                                                                                <ControlTemplate TargetType="Button">
                                                                                    <Grid Background="{TemplateBinding Background}">
                                                                                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="12,6"/>
                                                                                        <Border BorderBrush="#F0F0F0" BorderThickness="0,0,0,1" VerticalAlignment="Bottom"/>
                                                                                    </Grid>
                                                                                </ControlTemplate>
                                                                            </Setter.Value>
                                                                        </Setter>
                                                                        <Style.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter Property="Background" Value="#F7F7F7"/>
                                                                            </Trigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Button.Style>
                                                                <StackPanel>
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <Border CornerRadius="4" Padding="5,1" VerticalAlignment="Top">
                                                                            <Border.Style>
                                                                                <Style TargetType="Border">
                                                                                    <Setter Property="Background" Value="#DCFCE7"/>  <!-- Done: xanh -->
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding Kind}" Value="Update">
                                                                                            <Setter Property="Background" Value="#FEF3C7"/>  <!-- Update: cam -->
                                                                                        </DataTrigger>
                                                                                        <DataTrigger Binding="{Binding Kind}" Value="Warning">
                                                                                            <Setter Property="Background" Value="#FEE2E2"/>  <!-- Warning: đỏ -->
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </Border.Style>
                                                                            <TextBlock FontSize="8" FontWeight="SemiBold" TextAlignment="Center">
                                                                                <TextBlock.Style>
                                                                                    <Style TargetType="TextBlock">
                                                                                        <Setter Property="Text" Value="{l10n:Loc Main.NotifBadgeDone}"/>
                                                                                        <Setter Property="Foreground" Value="#16A34A"/>
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding Kind}" Value="Update">
                                                                                                <Setter Property="Text" Value="{l10n:Loc Main.NotifBadgeUpdate}"/>
                                                                                                <Setter Property="Foreground" Value="#B45309"/>
                                                                                            </DataTrigger>
                                                                                            <DataTrigger Binding="{Binding Kind}" Value="Warning">
                                                                                                <Setter Property="Text" Value="{l10n:Loc Main.NotifBadgeError}"/>
                                                                                                <Setter Property="Foreground" Value="#B91C1C"/>
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </TextBlock.Style>
                                                                            </TextBlock>
                                                                        </Border>
                                                                        <TextBlock Text="{Binding Title}" FontSize="11.5" FontWeight="Medium"
                                                                                   Foreground="{StaticResource TextBrush}" Margin="8,0,0,0" VerticalAlignment="Center"
                                                                                   TextTrimming="CharacterEllipsis"/>
                                                                    </StackPanel>
                                                                    <TextBlock Text="{Binding Detail}" FontSize="9.5" Foreground="{StaticResource MutedBrush}"
                                                                               Margin="0,2,0,0" TextWrapping="Wrap" MaxWidth="300"/>
                                                                    <TextBlock Text="{Binding TimeText}" FontSize="8.5" Foreground="{StaticResource FaintBrush}"
                                                                               Margin="0,2,0,0" HorizontalAlignment="Right"/>
                                                                </StackPanel>
                                                            </Button>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                </ScrollViewer>
                                                <!-- Vùng trống khi chưa có thông báo nào -->
                                                <TextBlock x:Name="NotifEmptyText" Text="{l10n:Loc Main.NotifEmpty}" FontSize="11"
                                                           Foreground="{StaticResource FaintBrush}" Margin="16,6,0,14"
                                                           Visibility="Collapsed"/>
                                            </StackPanel>
                                        </Border>
                                    </Popup>
                                </StackPanel>
            </DockPanel>
        </Border>

<!-- ===== Toolbar ===== -->
        <Border Grid.Row="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Background="#FFFFFF">
            <DockPanel Margin="16,8">
                <Button Content="{l10n:Loc Main.AddFilesButton}" Style="{StaticResource RoundedBtn}" Padding="16,7" Click="AddFiles_Click" ToolTip="{l10n:Loc Main.AddFilesButton}"/>
                <ComboBox x:Name="PrinterCombo" Width="240" Margin="16,0,0,0" VerticalAlignment="Center"
                          DisplayMemberPath="Name"
                          SelectedItem="{Binding SelectedPrinter, Mode=TwoWay}"
                          ToolTip="{Binding SelectedItem.Name, RelativeSource={RelativeSource Self}}"/>
                <!-- Status dot: dot màu + padding đều 2 bên (status chi tiết ở tooltip) -->
                <Ellipse x:Name="PrinterStatusDot" Width="10" Height="10" Fill="{StaticResource ReadyBrush}"
                         VerticalAlignment="Center" Margin="12,0,12,0" Stroke="#FFFFFF" StrokeThickness="1.5"
                         ToolTip="{l10n:Loc Main.PrinterStatusTooltip}" RenderOptions.EdgeMode="Aliased"/>
                <!-- Nhắc khi khởi động: xác nhận đã chọn đúng máy in (tránh in lộn máy) — hiện ổn định, chỉ bấm ✕ mới tắt -->
                <Border x:Name="PrinterReminder" Background="#FFF9ED" BorderBrush="#EAB308" BorderThickness="1"
                        CornerRadius="6" Padding="8,4" Margin="0,0,8,0" VerticalAlignment="Center" Visibility="Collapsed"
                        ToolTip="{l10n:Loc Main.PrinterReminderTooltip}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{l10n:Loc Main.PrinterReminderText}" FontSize="11" Foreground="#92400E"
                                   FontWeight="SemiBold" TextWrapping="Wrap" MaxWidth="320" VerticalAlignment="Center"/>
                        <Button x:Name="PrinterReminderClose" Content="✕" Style="{StaticResource GhostBtn}"
                                FontSize="10" Padding="4,0" Margin="8,0,0,0" VerticalAlignment="Center" Cursor="Hand"
                                Click="PrinterReminderClose_Click" AutomationProperties.AutomationId="PrinterReminderCloseBtn"
                                ToolTip="{l10n:Loc About.CloseButton}"/>
                    </StackPanel>
                </Border>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
<Button Content="{l10n:Loc Main.PrintSettingsButton}" Style="{StaticResource GhostBtn}" Click="PrintSettings_Click"
                                              Padding="14,6" Margin="0,0,8,0" AutomationProperties.AutomationId="PrintSettingsBtn"
                                              ToolTip="{l10n:Loc Main.PrintSettingsTooltip}"/>
                                     <Button Content="{l10n:Loc Main.PrintersButton}" Style="{StaticResource GhostBtn}"
                                              Click="Printers_Click" Padding="12,6" Margin="0,0,8,0"
                                              ToolTip="{l10n:Loc Main.PrintersButton}"/>
                                     <Button Content="{l10n:Loc Main.ManagePresetsButton}" Style="{StaticResource GhostBtn}"
                                              Click="ManagePresets_Click" Padding="12,6" Margin="0,0,8,0"
                                              AutomationProperties.AutomationId="ManagePresetsBtn"
                                              ToolTip="{l10n:Loc Main.ManagePresetsButton}"/>
                                     <Button Content="{l10n:Loc Main.WatchButton}" x:Name="WatchFoldersBtn" Style="{StaticResource GhostBtn}"
                                              Click="WatchFolders_Click" Padding="12,6" Margin="0,0,8,0"
                                              AutomationProperties.AutomationId="WatchFoldersBtn"
                                              ToolTip="{l10n:Loc Main.WatchButton}"/>
                                     <Button Content="{l10n:Loc Stop.CancelBatch}" Style="{StaticResource GhostBtn}"
                                              Click="CancelBatch_Click" Padding="12,6" Margin="0,0,8,0"
                                              AutomationProperties.AutomationId="CancelBatchBtn"
                                              ToolTip="{l10n:Loc Stop.CancelBatch}"/>
                                     <!-- Nút print DUY NHẤT, 3 trạng thái: rảnh = "Print all (N)" · đang in = "⏸ Pause" (đỏ, dừng lô) · tạm dừng = "▶ Resume" (xanh lá) -->
                                     <Button Content="{l10n:Loc Main.PrintMainButton}" x:Name="PrintMainBtn" Style="{StaticResource RoundedBtn}"
                                              Padding="18,7" Click="PrintMain_Click" AutomationProperties.AutomationId="PrintMainBtn"/>
                                 </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===== Error banner ===== -->
        <Border Grid.Row="2" x:Name="ErrorBanner" Background="{StaticResource WarnBgBrush}" BorderBrush="#EAB308"
                BorderThickness="1" CornerRadius="6" Margin="16,8" Padding="12,8" Visibility="Collapsed">
            <DockPanel>
                <TextBlock x:Name="ErrorBannerIcon" Text="!" Foreground="{StaticResource WarnBrush}" FontWeight="Bold" FontSize="15"
                           Margin="0,0,10,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="ErrorBannerText" Foreground="#92400E" FontSize="12.5" VerticalAlignment="Center"
                           TextWrapping="Wrap"/>
                <!-- ✕ đóng banner — luôn hiện, bất kể lỗi có retry được hay không -->
                <Button Content="✕" DockPanel.Dock="Right" Style="{StaticResource GhostBtn}" Padding="8,2"
                        Margin="0,0,4,0" VerticalAlignment="Center" Click="BannerClose_Click"
                        ToolTip="{l10n:Loc Main.BannerCloseTooltip}"/>
                <!-- Nút retry: nhãn + Tag (mã lỗi) được FooterController.ShowBanner đặt theo loại lỗi -->
                <Button x:Name="RetryBtn" DockPanel.Dock="Right" Margin="0,0,10,0"
                        Background="Transparent" BorderThickness="0" Foreground="{StaticResource WarnBrush}"
                        FontWeight="SemiBold" Cursor="Hand" Click="RetryConnection_Click"
                        Visibility="Collapsed"/>
            </DockPanel>
        </Border>

        <!-- ===== Approval bar (job từ AI/MCP chờ người duyệt) ===== -->
        <Border Grid.Row="3" x:Name="ApprovalBar" Background="{StaticResource WarnBgBrush}" BorderBrush="{StaticResource WarnBrush}"
                BorderThickness="1" CornerRadius="6" Margin="16,6,16,0" Padding="12,8" Visibility="Collapsed">
            <DockPanel LastChildFill="False">
                <TextBlock x:Name="ApprovalTitle" FontSize="13" FontWeight="SemiBold" Foreground="#92400E" VerticalAlignment="Center">
                    <Run Text="{l10n:Loc Approve.Title}"/>
                    <Run Text=" · "/>
                    <Run Text="{l10n:Loc Approve.QueueTitle}"/>
                </TextBlock>
                <TextBlock x:Name="ApprovalCount" FontSize="12" Foreground="#92400E" VerticalAlignment="Center" Margin="8,0,0,0"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="{l10n:Loc Approve.ApproveAll}" Style="{StaticResource RoundedBtn}" Padding="12,5"
                            Background="{StaticResource ReadyBrush}" Foreground="White" FontSize="11"
                            Click="ApproveAll_Click" AutomationProperties.AutomationId="ApproveAllBtn"
                            ToolTip="{l10n:Loc Approve.ApproveAll}"/>
                    <Button Content="{l10n:Loc Approve.RejectAll}" Style="{StaticResource GhostBtn}" Padding="12,5"
                            FontSize="11" Margin="8,0,8,0"
                            Click="RejectAll_Click" AutomationProperties.AutomationId="RejectAllBtn"
                            ToolTip="{l10n:Loc Approve.RejectAll}"/>
                    <Button Content="✕" Style="{StaticResource GhostBtn}" Padding="8,2" FontSize="11"
                            VerticalAlignment="Center" Click="ApprovalClose_Click"
                            ToolTip="{l10n:Loc Main.BannerCloseTooltip}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===== Job table ===== -->
        <Grid Grid.Row="4" Margin="16,4,16,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header row -->
            <Border Grid.Row="0" Background="{StaticResource HeaderBgBrush}" CornerRadius="4" Padding="8,0" Height="34">
                <Grid>
                    <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="52"/>
                                            <ColumnDefinition Width="14"/>
                                            <ColumnDefinition Width="3*"/>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="116"/>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="2.5*"/>
                                            <ColumnDefinition Width="*" x:Name="ColPrinterWidth"/>
                                            <ColumnDefinition Width="16" x:Name="ColPrinterSpacer"/>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="2*"/>
                                        </Grid.ColumnDefinitions>
                                        <!-- Chọn tất cả / bỏ chọn (header của cột checkbox) — click: chưa chọn hết → chọn hết; đã chọn hết → bỏ hết -->
                                        <CheckBox Grid.Column="0" Grid.ColumnSpan="2" x:Name="SelectAllChk"
                                                  HorizontalAlignment="Left" VerticalAlignment="Center" Cursor="Hand"
                                                  ToolTip="{l10n:Loc Main.SelectAllTooltip}" Click="SelectAllChk_Click"/>
                                        <TextBlock Grid.Column="3" Text="{l10n:Loc Main.ColName}" x:Name="SortName" Tag="Name" Cursor="Hand"
                                               Foreground="{StaticResource MutedBrush}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                                               ToolTip="{l10n:Loc Main.ColNameTooltip}" PreviewMouseLeftButtonDown="Sort_Column"
                                               TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="5" Text="{l10n:Loc Main.ColPages}" x:Name="SortPages" Tag="Pages" Cursor="Hand"
                                               Foreground="{StaticResource MutedBrush}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" TextAlignment="Center"
                                               ToolTip="{l10n:Loc Main.ColPagesTooltip}" PreviewMouseLeftButtonDown="Sort_Column"
                                               TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="7" Text="{l10n:Loc Main.ColSettings}" x:Name="SortSettings" Tag="Settings" Cursor="Hand"
                                               Foreground="{StaticResource MutedBrush}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                                               ToolTip="{l10n:Loc Main.ColSettingsTooltip}"
                                               PreviewMouseLeftButtonDown="Sort_Column"
                                               TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="8" Text="{l10n:Loc Main.ColPrinter}" x:Name="ColPrinter"
                                               Foreground="{StaticResource MutedBrush}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="11" Text="{l10n:Loc Main.ColStatus}" x:Name="SortStatus" Tag="Status" Cursor="Hand"
                                               Foreground="{StaticResource MutedBrush}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                                               ToolTip="{l10n:Loc Main.ColStatusTooltip}" PreviewMouseLeftButtonDown="Sort_Column"
                                               TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="13" Text="{l10n:Loc Main.ColError}" Foreground="{StaticResource MutedBrush}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                </Grid>
            </Border>

            <!-- Jobs list — grouped theo folder (main row = folder cha, sub rows = file) -->
            <ListBox Grid.Row="1" x:Name="JobList" BorderThickness="0" Background="Transparent"
                             ItemsSource="{Binding Jobs}" SelectionMode="Extended"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" Margin="0,4,0,0">
                <ListBox.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource HeaderBgBrush}" CornerRadius="5" Padding="8,3" Margin="0,8,0,2">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📁" FontSize="11" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Name, Converter={StaticResource FolderLeaf}}" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" Margin="6,0,0,0"
                                                   ToolTip="{Binding Name}"/>
                                        <TextBlock Text="{Binding ItemCount, StringFormat=' ({0})'}" FontSize="11"
                                                   Foreground="{StaticResource FaintBrush}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListBox.GroupStyle>
                <ListBox.InputBindings>
                    <!-- Delete = xóa các file đang chọn khỏi hàng đợi (song song menu chuột phải) -->
                    <KeyBinding Key="Delete" Command="ApplicationCommands.Delete"/>
                </ListBox.InputBindings>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="FocusVisualStyle" Value="{StaticResource RowFocusVisual}"/>
                        <Style.Triggers>
                            <!-- Hover + selected → hàng có phản hồi rõ ràng (UX) -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F7F7F7"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#EEF4FB"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="RowBg" Background="Transparent" BorderThickness="0" Padding="8,2" Height="38">
                            <Border.ContextMenu>
                                                            <ContextMenu Opened="RowContextMenu_Opening">
                                                                <MenuItem x:Name="CtxOpen" Header="{l10n:Loc Main.CtxOpen}" Click="CtxOpen_Click" Tag="&#xE8A5;"/>
                                                                <MenuItem x:Name="CtxEdit" Header="{l10n:Loc Main.CtxEdit}" Click="CtxEdit_Click" Tag="&#xE70F;"
                                                                          ToolTip="{l10n:Loc Main.CtxEditTooltip}"/>
                                                                <Separator/>
                                                                <MenuItem x:Name="CtxPrint" Header="{l10n:Loc Main.CtxPrint}" Click="CtxPrint_Click" Tag="&#xE749;"/>
                                                                <MenuItem x:Name="CtxItemSettings" Header="{l10n:Loc Main.CtxItemSettings}" Click="CtxItemSettings_Click" Tag="&#xE713;"
                                                                          ToolTip="{l10n:Loc Main.CtxItemSettingsTooltip}"/>
                                                                <MenuItem x:Name="CtxPageRange" Header="{l10n:Loc Main.CtxPageRange}" Click="CtxPageRange_Click" Tag="&#xE7C3;"/>
                                                                <Separator/>
                                                                <MenuItem x:Name="CtxRemove" Header="{l10n:Loc Main.CtxRemove}" Click="CtxRemove_Click" Tag="&#xE74D;"
                                                                          Style="{StaticResource DangerMenuItem}"/>
                                                            </ContextMenu>
                                                        </Border.ContextMenu>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="16"/>
                                                                    <ColumnDefinition Width="52"/>
                                                                    <ColumnDefinition Width="14"/>
                                                                    <ColumnDefinition Width="3*"/>
                                                                    <ColumnDefinition Width="16"/>
                                                                    <ColumnDefinition Width="116"/>
                                                                    <ColumnDefinition Width="16"/>
                                                                    <ColumnDefinition Width="2.5*"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="16"/>
                                                                    <ColumnDefinition Width="16"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="16"/>
                                                                    <ColumnDefinition Width="2*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <!-- checkbox -->
                                                                <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" VerticalAlignment="Center"/>
                                                                <!-- format badge -->
                                                                <Border Grid.Column="1" Background="#F0F0F0" CornerRadius="3" Padding="4,1" Width="46" Height="18" VerticalAlignment="Center" HorizontalAlignment="Left">
                                                                    <TextBlock Text="{Binding Format}" FontSize="9" Foreground="{StaticResource FaintBrush}"
                                                                               FontWeight="SemiBold" TextAlignment="Center"/>
                                                                </Border>
                                                                <!-- name + reloaded badge -->
                                                                <WrapPanel Grid.Column="3" VerticalAlignment="Center" Orientation="Horizontal">
                                                                    <TextBlock Text="{Binding FileName}" Foreground="{StaticResource TextBrush}"
                                                                               FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                                               ToolTip="{Binding FilePath}">
                                                                        <TextBlock.InputBindings>
                                                                            <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding DataContext.OpenFileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                          CommandParameter="{Binding}"/>
                                                                        </TextBlock.InputBindings>
                                                                    </TextBlock>
                                                                    <!-- ↻ Reloaded badge (WasReloaded → Border + chữ cùng hiển thị; mặc định ẩn BORDER — tránh "đốm vàng" lạ) -->
                                                                    <Border Background="#FFF9ED" BorderBrush="#EAB308" BorderThickness="1" CornerRadius="8"
                                                                            Padding="4,0" Margin="6,0,0,0" VerticalAlignment="Center">
                                                                        <Border.Style>
                                                                            <Style TargetType="Border">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding WasReloaded}" Value="True">
                                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Border.Style>
                                                                        <TextBlock Text="{l10n:Loc Main.ReloadedBadge}" FontSize="9" FontWeight="SemiBold" Foreground="#CA8A04"/>
                                                                    </Border>
                                                                </WrapPanel>
                                                                <!-- pages to print — bấm mở popup chọn Tất cả / khoảng trang -->
                                                                <Border Grid.Column="5" x:Name="PagesCell" Background="#FFFFFF"
                                                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                                        CornerRadius="4" Padding="6,2" Cursor="Hand" VerticalAlignment="Center"
                                                                        MouseLeftButtonUp="PagesCell_Click"
                                                                        ToolTip="{l10n:Loc Main.PagesCellTooltip}">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <!-- Hiển thị: "Tất cả" khi trống/All, còn lại hiện range đã nhập -->
                                                                        <TextBlock FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                                                            <TextBlock.Style>
                                                                                <Style TargetType="TextBlock">
                                                                                    <Setter Property="Text" Value="{Binding Config.PageRange}"/>
                                                                                    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding Config.PageRange}" Value="">
                                                                                            <Setter Property="Text" Value="{l10n:Loc Main.PagesAll}"/>
                                                                                            <Setter Property="Foreground" Value="{StaticResource FaintBrush}"/>
                                                                                        </DataTrigger>
                                                                                        <DataTrigger Binding="{Binding Config.PageRange}" Value="All">
                                                                                            <Setter Property="Text" Value="{l10n:Loc Main.PagesAll}"/>
                                                                                            <Setter Property="Foreground" Value="{StaticResource FaintBrush}"/>
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </TextBlock.Style>
                                                                        </TextBlock>
                                                                        <TextBlock Text=" ▾" FontSize="9" Foreground="{StaticResource FaintBrush}"
                                                                                   VerticalAlignment="Center"/>
                                                                    </StackPanel>
                                                                </Border>
                                                                <Popup x:Name="PagesPopup" PlacementTarget="{Binding ElementName=PagesCell}" Placement="Bottom"
                                                                       StaysOpen="True" AllowsTransparency="True">
                                                                    <Border Background="White" BorderBrush="#EAEAEA" BorderThickness="1" CornerRadius="10"
                                                                            Padding="14,12" Width="270" Margin="0,4,0,0">
                                                                        <Border.Effect>
                                                                            <DropShadowEffect BlurRadius="20" ShadowDepth="3" Direction="270" Opacity="0.16" Color="#000000"/>
                                                                        </Border.Effect>
                                                                        <StackPanel>
                                                                            <TextBlock Text="{l10n:Loc Main.PagesPopupTitle}" FontSize="12.5" FontWeight="SemiBold" Foreground="#1F1F1F"/>
                                                                            <!-- GroupName theo FilePath: 2 radio nằm trong 2 StackPanel khác nhau nên KHÔNG
                                                                                 tự loại nhau — phải gán nhóm tường minh, duy nhất theo từng dòng (job) -->
                                                                            <RadioButton x:Name="PRangeAll" Content="{l10n:Loc Main.PagesAllRadio}" FontSize="12" Margin="0,8,0,0"
                                                                                         GroupName="{Binding FilePath}" Checked="PRangeMode_Changed"/>
                                                                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                                                <RadioButton x:Name="PRangeCustom" Content="{l10n:Loc Main.PagesCustomRadio}" FontSize="12"
                                                                                             GroupName="{Binding FilePath}"
                                                                                             VerticalAlignment="Center" Checked="PRangeMode_Changed"/>
                                                                                <TextBox x:Name="PRangeBox" Width="110" FontSize="12" Padding="3,2" Margin="8,0,0,0"
                                                                                         IsEnabled="False" VerticalContentAlignment="Center"
                                                                                         ToolTip="{l10n:Loc Main.PagesCustomTooltip}"/>
                                                                            </StackPanel>
                                                                            <TextBlock Text="{l10n:Loc Main.PagesSyntax}"
                                                                                       FontSize="10.5" Foreground="#8A8A8A" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                                                            <TextBlock x:Name="PSheetLabel" Text="{l10n:Loc Main.SheetLabel}" FontSize="12.5" FontWeight="SemiBold"
                                                                                       Foreground="#1F1F1F" Margin="0,12,0,0" Visibility="Collapsed"/>
                                                                            <ComboBox x:Name="PSheetCombo" FontSize="12" Margin="0,6,0,0" Visibility="Collapsed"
                                                                                      ToolTip="{l10n:Loc Main.SheetComboTooltip}"/>
                                                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                                                                                <Button Content="{l10n:Loc Main.PagesCloseButton}" Style="{StaticResource GhostBtn}" Padding="10,6"
                                                                                        Margin="0,0,8,0" Click="PagesClose_Click"/>
                                                                                <Button Content="{l10n:Loc Common.ApplyButton}" Style="{StaticResource RoundedBtn}" Padding="14,6"
                                                                                        Click="PagesApply_Click"/>
                                                                            </StackPanel>
                                                                        </StackPanel>
                                                                    </Border>
                                                                </Popup>
                                                                <!-- settings — bấm trực tiếp để mở cấu hình in của file (thay vì chỉ chuột phải → menu) -->
                                                                                                <TextBlock Grid.Column="7" VerticalAlignment="Center"
                                                                                                           Text="{Binding Config.SummaryText, Mode=OneWay}"
                                                                                                           TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Cursor="Hand"
                                                                                                           MouseLeftButtonUp="SettingsCell_Click"
                                                                                                           ToolTip="{l10n:Loc Main.SettingsCellTooltip}"/>
                                                                <!-- máy in riêng per-file — chọn máy thật → HasPerFilePrinter; "Theo máy thanh công cụ" = dùng máy toolbar -->
                                                                <ComboBox x:Name="RowPrinterCombo" Grid.Column="8" Width="Auto" MinWidth="90"
                                                                          ItemsSource="{Binding Printers, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                          DisplayMemberPath="Name" VerticalAlignment="Center"
                                                                          SelectionChanged="PrinterPerFile_SelectionChanged"
                                                                          Loaded="PrinterPerFile_Loaded"/>
                                                                <!-- status pill -->
                                                                <Border Grid.Column="11" CornerRadius="10" Padding="10,1" VerticalAlignment="Center" HorizontalAlignment="Left">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <!-- Mặc định (Queued, Cancelled): xám idle — chưa chạy, chứ KHÔNG phải done -->
                                            <Setter Property="Background" Value="{StaticResource HeaderBgBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding State}" Value="Done">
                                                    <Setter Property="Background" Value="{StaticResource ReadyBgBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="Error">
                                                    <Setter Property="Background" Value="{StaticResource ErrorBgBrush}"/>
                                                </DataTrigger>
                                                <!-- Converting/Spooling = đang chạy → amber in-progress -->
                                                <DataTrigger Binding="{Binding State}" Value="Converting">
                                                    <Setter Property="Background" Value="{StaticResource WarnBgBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="Spooling">
                                                    <Setter Property="Background" Value="{StaticResource WarnBgBrush}"/>
                                                </DataTrigger>
                                                <!-- AI job chờ duyệt → amber, cần người hành động -->
                                                <DataTrigger Binding="{Binding State}" Value="AwaitingApproval">
                                                    <Setter Property="Background" Value="{StaticResource WarnBgBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
<TextBlock FontSize="11" TextAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"
                                           Text="{Binding StateText}"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding StateText}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding State}" Value="Done">
                                                    <Setter Property="Foreground" Value="{StaticResource ReadyBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="Error">
                                                    <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="Converting">
                                                    <Setter Property="Foreground" Value="{StaticResource WarnBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="Spooling">
                                                    <Setter Property="Foreground" Value="{StaticResource WarnBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="AwaitingApproval">
                                                    <Setter Property="Foreground" Value="{StaticResource WarnBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                </Border>
                                <!-- error -->
                                <TextBlock Grid.Column="13" Text="{Binding Error.Message}" Foreground="{StaticResource ErrorBrush}"
                                           FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Error.Hint}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Empty state: hướng dẫn khi hàng đợi trống (ẩn khi có file hoặc đang tìm kiếm) -->
            <StackPanel x:Name="EmptyState" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                        IsHitTestVisible="False">
                <Border Width="64" Height="64" CornerRadius="16" Background="{StaticResource HeaderBgBrush}"
                        HorizontalAlignment="Center">
                    <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="28"
                               Foreground="{StaticResource FaintBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="{l10n:Loc Main.EmptyStateTitle}" FontSize="14" FontWeight="SemiBold"
                           Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" Margin="0,14,0,0"
                           TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{l10n:Loc Main.EmptyStateHint}" FontSize="12"
                           Foreground="{StaticResource FaintBrush}" HorizontalAlignment="Center" Margin="0,5,0,0"
                           TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </Grid>

        <!-- ===== Bulk bar (gọn — chỉ khi có selection): count + summary + mở bảng cấu hình đầy đủ ===== -->
        <Border Grid.Row="5" x:Name="BulkBar" Background="#F6F6F4" BorderBrush="#D4D4D4" BorderThickness="1"
                CornerRadius="8" Margin="16,8" Padding="14,8" Visibility="Collapsed">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock x:Name="BulkCountText" Text="{l10n:Loc Main.BulkCountFormat}" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}"/>
                    <TextBlock x:Name="BulkSummaryText" Text="" FontSize="11" Foreground="{StaticResource FaintBrush}"
                               TextTrimming="CharacterEllipsis" MaxWidth="640"
                               ToolTip="{l10n:Loc Main.BulkSummaryTooltip}"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{l10n:Loc Main.BulkFullText}"
                               FontSize="11" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                    <Button Content="{l10n:Loc Main.BulkSettingsButton}" Style="{StaticResource RoundedBtn}"
                            Padding="14,7" Margin="10,0,0,0" Click="BulkSettings_Click"
                            ToolTip="{l10n:Loc Main.BulkSettingsTooltip}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===== Footer ===== -->
        <Border Grid.Row="6" Background="{StaticResource HeaderBgBrush}" CornerRadius="4" Margin="16,6">
            <DockPanel>
                <TextBlock x:Name="FooterStats" Text="{l10n:Loc Main.FooterStatsFormat}" FontSize="12"
                           Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="10,0"
                           TextTrimming="CharacterEllipsis"/>
                <!-- Progress bar (Penpot gap) -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                    <TextBlock x:Name="ProgressText" Text="0%" FontSize="11" Foreground="{StaticResource MutedBrush}"
                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ProgressBar x:Name="FooterProgress" Width="150" Height="6" Minimum="0" Maximum="100" Value="0"
                                 Foreground="{StaticResource ReadyBrush}" Background="#E5E5E5" BorderThickness="0"/>
                </StackPanel>
                <!-- (Xóa file đã in khỏi hàng đợi giờ nằm TRONG popup 'In xong' — không có tick ở footer nữa) -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0,12,0">
                                    <TextBlock x:Name="FooterHint" Text="{l10n:Loc Main.FooterHintDefault}"
                                               FontSize="11" Foreground="{StaticResource FaintBrush}" VerticalAlignment="Center" Margin="0,0,14,0"
                                               TextTrimming="CharacterEllipsis" MaxWidth="640"/>
                                    <!-- Nút Info — mở changelog + about + contact + license -->
                                    <Button Content="{l10n:Loc Main.InfoButton}" Style="{StaticResource GhostBtn}" Padding="10,4" FontSize="10.5"
                                            Click="Info_Click" ToolTip="{l10n:Loc Main.InfoTooltip}"/>
                                </StackPanel>
            </DockPanel>
        </Border>
    <!-- ===== Toast success (Penpot gap) ===== -->
        <Border x:Name="Toast" Grid.Row="4" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                CornerRadius="10" Padding="14,10" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,16,12" Panel.ZIndex="100" Visibility="Collapsed" Opacity="0">
            <DockPanel>
                <TextBlock Text="✓" Foreground="{StaticResource ReadyBrush}" FontWeight="Bold" FontSize="14"
                           Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="ToastText" FontSize="12.5" Foreground="{StaticResource TextBrush}"
                           VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="320"/>
            </DockPanel>
        </Border>

        <!-- ===== Drop highlight: overlay toàn cửa sổ khi kéo thả file (hiện qua DragEnter, ẩn qua DragLeave/Drop) ===== -->
        <Border x:Name="DropHighlight" Grid.RowSpan="7" Panel.ZIndex="500" IsHitTestVisible="False"
                Background="{StaticResource HeaderBgBrush}" Opacity="0.9" Visibility="Collapsed">
            <Grid>
                <Rectangle Margin="14" RadiusX="12" RadiusY="12" Stroke="{StaticResource AccentBrush}"
                           StrokeThickness="2" StrokeDashArray="6 4" Opacity="0.5"/>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="36"
                               Foreground="{StaticResource AccentBrush}" Opacity="0.3"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="{l10n:Loc Main.DropHighlightTitle}" FontSize="16" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}" Margin="0,10,0,0"
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{l10n:Loc Main.DropHighlightHint}"
                               FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>